{
  "name": "@njiedev/gu",
  "version": "0.1.1",
  "mcpName": "io.github.njiedev/gu",
  "description": "Turn your scripts and CLIs into tested MCP tools for Claude Code, Codex and any MCP client. One command, local, no server to write.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "openai-codex",
    "ai-agents",
    "agent-tools",
    "llm-tools",
    "tool-calling",
    "cli-to-mcp",
    "script-to-mcp",
    "mcp-tools",
    "cli",
    "scripts",
    "automation",
    "developer-tools",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "njiedev",
  "homepage": "https://github.com/njiedev/gu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njiedev/gu.git"
  },
  "bugs": {
    "url": "https://github.com/njiedev/gu/issues"
  },
  "type": "module",
  "bin": {
    "gu": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts",
    "build": "bun build --compile src/cli.ts --outfile dist/gu",
    "build:npm": "bun scripts/build-npm.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build:npm"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "openai": "^7.35.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
